schema_version = 4

[library]
# Raízes varridas pelo scanner.
roots = ["D:/Music"]
extensions = ["mp3", "flac", "m4a", "aiff", "wav", "ogg", "opus"]
follow_symlinks = false

[catalog]
# Caminho do SQLite. Vazio = usa o diretório de dados do usuário.
path = ""
hash_algorithm = "blake2b"
hash_files = true

[classification]
taxonomy = "genres.yaml"
local_taxonomy = "genres.local.yaml"
enable = ["tags", "rules"]

[files]
# hardlink = árvore organizada sem tocar nos originais (Seguro).
# move     = reorganiza os arquivos e atualiza o catálogo.
# tag_only = apenas grava tags DJLIFE_*, sem mexer em pastas.
strategy = "hardlink"
# Destino da árvore organizada (obrigatório para `plan`/`apply`).
target = "D:/Music/Organizado"
# Destino da quarentena de duplicatas (obrigatório para `dedupe --apply`).
quarantine_dir = "D:/Music/_Quarentena"
template = "{genre}/{subgenre}/{artist} - {title}"
unknown_dir = "_NaoClassificado"

[integrations]
dj_software = ["rekordbox", "serato"]
# Rekordbox 6/7: master.db (SQLCipher) — relink requer o extra `rekordbox`.
rekordbox_db = ""
# Serato DJ 4.x: master.sqlite (SQLite/WAL). Usado por `status`/`relink`.
serato_db = ""
# Pasta _Serato_ legada (fallback para localizar master.sqlite).
serato_dir = ""

[analysis]
# Backend de análise de áudio do comando `analyze`.
# librosa  = roda nativo no Windows (extra `analysis`).
# essentia = mais preciso, sem wheel para Windows (extra `essentia`, Linux/WSL2/Docker).
backend = "librosa"
# fast = analisa apenas os primeiros `fast_seconds` (triagem rápida).
fast = false
fast_seconds = 90.0

[ml]
# Backend de embeddings (camadas L3/L4) usado por `embed`/`neighbors`.
# clap = CLAP via transformers (extra `ml`); mert = MERT-v1-95M via transformers (extra `ml`);
# muq  = MuQ-large-msd-iter via pacote `muq` (extra `muq`). Todos rodam em CPU.
backend = "clap"
# ID do modelo no HuggingFace (vazio = padrão laion/clap-htsat-unfused).
model = ""
# Segundos de áudio usados por faixa (vazio = faixa inteira).
window_seconds = 30.0
# k-NN: vizinhos considerados e similaridade mínima de cosseno.
neighbors = 10
min_similarity = 0.6
